@page
@model FundLens.Compliance.Pages.IndexModel
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Conformité – FundLens</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
<main class="container py-4">
  <h1 class="h3 mb-3">Contrôles de conformité</h1>
  <input id="filter" class="form-control mb-3" placeholder="Filtrer par fonds ou règle…">
  @if (Model.Reports.Count == 0)
  {
    <div class="alert alert-info">Aucun contrôle pour l'instant.</div>
  }
  else
  {
    <table class="table table-sm table-striped bg-white" id="reports">
      <thead><tr><th>Fonds</th><th>Date</th><th>Statut</th><th>Détail</th></tr></thead>
      <tbody>
      @foreach (var report in Model.Reports)
      {
        <tr>
          <td>@report.FundId</td>
          <td>@report.AsOf.ToString("dd/MM/yyyy")</td>
          <td>
            @if (report.Compliant) { <span class="badge text-bg-success">Conforme</span> }
            else { <span class="badge text-bg-danger">Dépassement</span> }
          </td>
          <td>
            @foreach (var v in report.Violations)
            {
              <div class="@(v.Severity == Severity.Breach ? "text-danger" : "text-warning")">@v.Rule – @v.Message</div>
            }
          </td>
        </tr>
      }
      </tbody>
    </table>
  }
</main>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="~/js/filter.js"></script>
</body>
</html>
