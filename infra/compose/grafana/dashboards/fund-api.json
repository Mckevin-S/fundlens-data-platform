{
  "title": "fund-api",
  "uid": "fundlens-fund-api",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries", "title": "Requêtes HTTP par seconde", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"fund-api\"}[5m]))" }]
    },
    {
      "type": "timeseries", "title": "Latence p95 (s)", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket[5m])))" }]
    },
    {
      "type": "stat", "title": "Erreurs 5xx (15 min)", "gridPos": { "x": 0, "y": 8, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(http_server_requests_seconds_count{status=~\"5..\"}[15m]))" }]
    }
  ]
}
