{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fundlens.local/contracts/market-prices.schema.json",
  "version": "1.0.0",
  "title": "Cours de marché quotidiens",
  "description": "Data product « Marchés » : un fichier par jour de cotation, fourni par le fournisseur de données.",
  "type": "object",
  "required": ["asOfDate", "source", "prices"],
  "additionalProperties": false,
  "properties": {
    "asOfDate": { "type": "string", "format": "date" },
    "source": { "type": "string", "minLength": 1 },
    "prices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["isin", "currency", "close"],
        "additionalProperties": false,
        "properties": {
          "isin": { "type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "close": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
